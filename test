    // newborn track's wide covariance makes every detection
    // and it steals from the established track beside it. Sorting also makes
    // the result independent of the order tracks and detecti
    std::ranges::sort(pairs_, {}, [](const Pair &p) {
                        return std::pair{p.tentative, p.cost};
    });
    track_taken_.assign(tracks_.size(), false);
    det_taken_.assign(dets.size(), false);
    for (const auto &[tentative, cost, ti, di] : pairs_) {
                        if (track_taken_[ti] || det_taken_[di])
                            continue;
                        track_taken_[ti] = det_taken_[di] = true;
                        auto &t = tracks_[ti];
                        t.filter.update(dets[di]);
                        ++t.hits;
                        t.misses = 0;
    }

    for (std::size_t ti = 0; ti < tracks_.size(); ++ti)
        if (!track_taken_[ti])
            ++tracks_[ti].misses;

    // A detection nobody claimed starts a tentative track.
    for (std::size_t di = 0; di < dets.size(); ++di)
        if (!det_taken_[di])
            tracks_.push_back({next_id_++, Filter{dets[di]}});

