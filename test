    std::vector<TrackRecord> Tracker::step(
        FrameId frame, double std::span<const Detection> dets) {
        for (auto &t : tracks_)
            t.filter.predict(dt);

        // Score every pair that falls inside the gate.
        pairs_.clear();
        for (std::size_t ti = 0; ti < tracks_.size(); ++ti)
            for (std::size_t di = 0; di < dets.size(); ++di) {
                const double cost = tracks_[ti].filter.distance(dets[di]);
                if (cost <= params_.gate)
                pairs_.push_back(
                    {tracks_[ti].hits < params_.confirm_hits,
        }

