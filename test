    // The estimator every track carries. AlphaBetaFilter is a dr
    // gate below is then in pixels rather than sigmas.
    using Filter = KalmanFilter;

    ///
    /// Tuning for track life: how close a detection has to fall to be claimed,
    /// and how many frames of evidence open and close a track.
    ///
    struct TrackParams {
        double gate = 9.21; // max Filter::distance to associate; chi^2(2), 99%
        int confirm_hits = 3; // hits before a track is reported
        int max_misses = 3;   // consecutive coasts before a track is dropped
    };

    ///
    /// One tracked object: its filter plus the bookkeeping that decides whether
    /// it is real yet and whether it is still alive.
    ///
    struct Track {
        TrackId id;
        Filter filter;
        int hits = 1;   // detections claimed so far
        int misses = 0; // consecutive frames without one
    };

    ///
    /// A confirmed track's estimate at one frame. Mirrors TruthR
    /// can be scored side by side.
    ///
    struct TrackRecord {
        FrameId frame_id;
        TrackId track_id;
        double row, col;
        double v_row, v_col;
    };

    ///
    /// Carries tracks from frame to frame. Association is greedy nearest
    /// neighbour: every in-gate track/detection pair is scored,
    /// claimed best-first until nothing within the gate is left.
    ///
    class Tracker {
        struct Pair {
            bool tentative; // unconfirmed tracks claim only what is left over
            double cost;
            std::size_t track, det;
        };

        TrackParams params_;
        std::vector<Track> tracks_;
        TrackId next_id_ = 1;

        // Scratch reused across frames, like the cluster stack.
        std::vector<Pair> pairs_;
        std::vector<bool> track_taken_, det_taken_;

      public:
        explicit Tracker(TrackParams params = {}) : params_{params} {}

        ///
        /// Advances every track by dt, claims detections, births
        /// tracks, and reports the confirmed ones.
        ///
        /// @param frame
        /// @param dt seconds since the previous call
        /// @param dets this frame's output from centroid_clusters
        /// @return one record per confirmed track, whether or no
        ///
        std::vector<TrackRecord> step(FrameId frame, double dt,
                                      std::span<const Detection> dets);

        std::span<const Track> tracks() const { return tracks_; }
    };

} // namespace opir

