AlphaBetaFilter::AlphaBetaFilter(const Detection &d, AlphaBet
    : x_{d.row, d.col, 0.0, 0.0}, p_{p} {}

void AlphaBetaFilter::predict(double dt) {
        x_.row += x_.v_row * dt;
        x_.col += x_.v_col * dt;
        dt_ = dt;
}

double AlphaBetaFilter::distance(const Detection &d) const {
        return std::hypot(d.row - x_.row, d.col - x_.col);
}

void AlphaBetaFilter::update(const Detection &d) {
        const double r_res = d.row - x_.row;
        const double c_res = d.col - x_.col;
        x_.row += p_.alpha * r_res;
        x_.col += p_.alpha * c_res;
        if (dt_ > 0.0) {
            x_.v_row += p_.beta * r_res / dt_;
            x_.v_col += p_.beta * c_res / dt_;
        }
}

KalmanFilter::KalmanFilter(const Detection &d, KalmanParams k
    : row_{d.row, 0.0, k.p0_pos, 0.0, k.p0_vel},
      col_{d.col, 0.0, k.p0_pos, 0.0, k.p0_vel}, k_{k} {}

void KalmanFilter::predict_axis(Axis &a, double dt) const {
        const double dt2 = dt * dt, dt3 = dt2 * dt, dt4 = dt3 * dt;
        // x = F x with F = [[1, dt], [0, 1]]
        a.p += a.v * dt;
        // P = F P F^T + Q with Q = q [[dt^4/4, dt^3/2], [dt^3/2,
        const double P00 =
            a.P00 + 2 * dt * a.P01 + dt2 * a.P11 + k_.q * dt4 / 4;
        const double P01 = a.P01 + dt * a.P11 + k_.q * dt3 / 2;
        const double P11 = a.P11 + k_.q * dt2;
        a.P00 = P00;
        a.P01 = P01;
        a.P11 = P11;
}

void KalmanFilter::update_axis(Axis &a, double z) const {
        // H = [1, 0]: only position is observed, so the innovati
        // variance are scalars and the gain is a pair.
        const double y = z - a.p;
        const double S = a.P00 + k_.r;
        const double K0 = a.P00 / S;
        const double K1 = a.P01 / S;
        a.p += K0 * y;
        a.v += K1 * y;
        // P = (I - K H) P
        const double P00 = (1 - K0) * a.P00;
        const double P01 = (1 - K0) * a.P01;
        const double P11 = a.P11 - K1 * a.P01;
        a.P00 = P00;
        a.P01 = P01;
        a.P11 = P11;
}

void KalmanFilter::predict(double dt) {
        predict_axis(row_, dt);
        predict_axis(col_, dt);
}

