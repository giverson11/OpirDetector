///
/// Constant-velocity estimate of one target, in pixels and p
///
struct TrackState {
    double row, col;
    double v_row, v_col;
};

///
/// Tuning for the alpha-beta filter: fixed gains, so it neve
/// much to trust itself. Cheap, and fine while targets really do fly straight.
///
struct AlphaBetaParams {
    double alpha = 0.6; // fraction of each residual applied
    double beta = 0.2;  // fraction applied to velocity, per second
};

///
/// Tuning for the Kalman filter. q and r set how quickly the gains settle:
/// large q keeps the filter nimble, large r makes it distrus
///
struct KalmanParams {
    double q = 1.0;        // process noise, accel spectral density px^2/s^3
    double r = 0.25;       // centroid variance px^2, ~(0.5 p
    double p0_pos = 1.0;   // initial position variance
    double p0_vel = 100.0; // initial velocity variance: unkn
};

///
/// Alpha-beta: predict along the current velocity, then pull
/// detection by a fixed fraction. The velocity gain needs the elapsed time,
/// so predict() remembers it for the update() that follows.
///
class AlphaBetaFilter {
    TrackState x_;
    AlphaBetaParams p_;
    double dt_ = 0.0;

  public:
    AlphaBetaFilter(const Detection &d, AlphaBetaParams p = {
        void predict(double dt);

        ///
        /// Pixel distance from the predicted position; gate it in pixels.
        ///
        double distance(const Detection &d) const;

        void update(const Detection &d);

        const TrackState &state() const { return x_; }
};

///
/// Kalman: same model, but it carries a covariance and derives the gains from
/// it each step, so it starts aggressive and settles as evid
/// and col are independent axes with identical dynamics, so this is two
/// 2-state filters rather than one 4-state one and needs no
///
class KalmanFilter {
        struct Axis {
            double p, v;          // position, velocity
            double P00, P01, P11; // covariance, symmetric
        };
        Axis row_, col_;
        KalmanParams k_;

        void predict_axis(Axis & a, double dt) const;
        void update_axis(Axis & a, double z) const;

      public:
        KalmanFilter(const Detection &d, KalmanParams k = {});

        void predict(double dt);

        ///
        /// Normalised innovation squared, chi-square with two degrees of
        /// freedom: gate at ~9.2 for 99%. A track that has coasted has a and so
        /// a wider gate, without anyone tuning it.
        ///
        double distance(const Detection &d) const;

        void update(const Detection &d);

        TrackState state() const { return {row_.p, col_.p, row_.v, col_.v}; }
};

} // namespace opir

